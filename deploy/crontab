# Maintenance jobs for pars-studio-api (installed into the deploy user's crontab by scripts/install-cron.sh)
*/10 * * * * cd /opt/apps/pars-studio-api && docker compose exec -T web python manage.py expire_pending_orders >> /opt/apps/pars-studio-api/cron.log 2>&1
*/10 * * * * cd /opt/apps/pars-studio-api && docker compose exec -T web python manage.py expire_reservation_holds >> /opt/apps/pars-studio-api/cron.log 2>&1
15 4 * * * cd /opt/apps/pars-studio-api && docker compose exec -T web python manage.py prune_db_task_results --min-age-days 30 >> /opt/apps/pars-studio-api/cron.log 2>&1
