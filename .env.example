# ───────────────────────────────────────────────────────────────
# Pars Studio API — environment variables
# Copy to `.env` for local development. In production the same
# file lives at /opt/pars-studio-api/.env on the VPS (never committed).
# ───────────────────────────────────────────────────────────────

# Django core. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=true
# Comma separated. Production: api.studiospars.com
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# PostgreSQL. Local: the compose.dev.yaml database.
# Production (same Docker network as laboflush): postgres://pars_studio_app:<pass>@postgres:5432/pars_studio
DATABASE_URL=postgres://pars:pars@localhost:5432/pars_studio

# Frontend (Next.js) origin. Links in emails and CORS/CSRF trust are derived from it.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Production only: share the session cookie between studiospars.com and api.studiospars.com
COOKIE_DOMAIN=

# Email. Local: consolemail:// prints to stdout.
# Production via Resend SMTP: smtp+ssl://resend:<RESEND_API_KEY>@smtp.resend.com:465
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Pars Studio <noreply@studiospars.com>
STUDIO_NOTIFICATION_EMAIL=parsstudiosofficial@gmail.com

# Google sign-in (Google Cloud Console → OAuth client, type "Web application").
# Authorised redirect URI: <API_ORIGIN>/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Background tasks. Production uses the database backend + `manage.py db_worker`.
# For a quick local run without a worker: django.tasks.backends.immediate.ImmediateBackend
TASKS_BACKEND=django_tasks_db.DatabaseBackend

# Cloudflare R2 (S3 compatible). Leave empty locally: files then go to ./media.
# Create two buckets: one public (covers, previews) with a public domain
# attached, one private (license files, uploads). Token needs object read/write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PUBLIC=pars-studio-public
R2_BUCKET_PRIVATE=pars-studio-private
# Public bucket's custom domain or r2.dev domain, without scheme (e.g. media.studiospars.com)
R2_PUBLIC_DOMAIN=
# Seconds a presigned download link stays valid
PRESIGNED_URL_TTL=900

# Optional error tracking
SENTRY_DSN=
